# ===========================================================================
# ARTSLY — environment
# §32.4: ".env.local is gitignored; .env.example is committed with EMPTY VALUES."
#
# EVERY VARIABLE BELOW IS OPTIONAL. A fresh clone runs with none of them set —
# the catalogue is committed and session state lives in a signed cookie. These
# exist so a real deployment can harden and extend the demo.
# ===========================================================================

# Signs the session cookie (HMAC-SHA256). Any string of 16+ characters.
# Unset in production, the app logs a loud warning and falls back to a public
# development key. Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# §32.1 / §38.3 — the password behind the two demo sign-in buttons.
# Demo mode is a REAL SIGN-IN; there is no auth bypass path in the codebase.
# Defaults to "artsly-demo" when unset.
DEMO_USER_PASSWORD=
# Must match DEMO_USER_PASSWORD. Read by the client-side sign-in buttons only.
NEXT_PUBLIC_DEMO_PASSWORD=

# Suppresses the production warning when you deliberately run with the
# development signing key (e.g. an ephemeral preview deploy).
ARTSLY_ALLOW_DEV_SECRET=

# ---------------------------------------------------------------------------
# Supabase (§43.1) — NOT required by this build.
#
# `supabase/migrations/0001_init.sql` implements §31 and §32 in full: schema,
# CHECK constraints generated from the §9 taxonomy, RLS on every table, and the
# `claim_artwork` concurrency function. The application currently reads the
# committed catalogue and writes session state to a cookie, so these are unused.
# See README "Data layer" before wiring them up.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# §32.4: service_role is used ONLY by seed scripts and is NEVER imported into
# anything under app/. Do not add it to a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
